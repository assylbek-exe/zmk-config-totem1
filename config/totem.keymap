#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
           &kp Q  &kp W  &kp E     &kp R  &kp T    &kp Y      &kp U            &kp I          &kp O    &kp P
           &kp A  &kp S  &kp D     &kp F  &kp G    &kp H      &kp J            &kp K          &kp L    &kp SEMI
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B    &kp N      &kp M            &kp COMMA      &kp DOT  &kp FSLH  &kp ENTER
                         &kp LGUI  &mo 2  &mo 1    &kp SPACE  &kp RIGHT_SHIFT  &kp BACKSPACE
            >;
        };

        nav_num {
            bindings = <
            &kp NUMBER_1  &kp NUMBER_2     &kp NUMBER_3    &kp NUMBER_4      &kp NUMBER_5    &kp NUMBER_6      &kp N7             &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
            &kp TAB       &msc SCRL_RIGHT  &msc SCRL_DOWN  &msc SCRL_LEFT    &kp GRAVE       &kp SQT           &kp LEFT           &kp UP        &kp RIGHT     &kp EQUAL
&kp ESCAPE  &kp TILDE     &none            &msc SCRL_UP    &kp LEFT_COMMAND  &none           &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DOWN      &kp MINUS     &kp BACKSLASH  &trans
                                           &trans          &trans            &trans          &trans            &trans             &kp DELETE
            >;
        };

        sym_func {
            bindings = <
            &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp LC(UP)    &kp C_AC_SEARCH   &kp LS(LG(NUMBER_4))    &kp LG(L)  &kp C_PREV         &kp C_PLAY_PAUSE   &kp C_NEXT         &kp LC(LG(Q))
            &kp TAB               &kp F1                &kp F2        &kp F3            &kp F4                  &none      &kp C_MUTE         &kp C_VOLUME_DOWN  &kp C_VOL_UP       &none
&kp ESCAPE  &kp LEFT_SHIFT        &kp LEFT_CONTROL      &kp LEFT_ALT  &kt LEFT_COMMAND  &none                   &none      &kp RIGHT_COMMAND  &kp RIGHT_ALT      &kp RIGHT_CONTROL  &kp RIGHT_SHIFT  &trans
                                                        &none         &trans            &trans                  &none      &none              &none
            >;
        };

        device {
            bindings = <
       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &none         &none         &none         &none         &none           &none         &none         &none         &none         &none
&none  &none         &none         &none         &none         &bt BT_CLR      &none         &none         &none         &none         &none         &bt BT_CLR
                                   &none         &none         &none           &none         &none         &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
