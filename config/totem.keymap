// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
// Miryoku Layout
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                    &kp Q        &kp W  &kp E        &kp R             &kp T        &kp Y        &kp U            &kp I       &kp O    &kp P
                    &kp A        &kp S  &kp D        &kp F             &kp G        &kp H        &kp J            &kp K       &kp L    &kp SEMI
&mt LEFT_SHIFT TAB  &mt RCTRL Z  &kp X  &kp C        &kp V             &kp B        &kp N        &kp M            &kp COMMA   &kp DOT  &mt FSLH RIGHT_CONTROL  &mt RIGHT_SHIFT SQT
                                        &lt 2 GRAVE  &kp LEFT_COMMAND  &kp SPACE    &lt 3 ENTER  &lt 1 BACKSPACE  &kp ESCAPE
            >;
        };

        num_sym {
            bindings = <
        &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4    &kp NUMBER_5       &kp NUMBER_6      &kp N7             &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
        &kp EXCLAMATION  &kp AT        &kp POUND      &kp DOLLAR      &kp PERCENT        &kp CARET         &kp AMPERSAND      &kp ASTERISK  &kp MINUS     &kp EQUAL
&trans  &kp GRAVE        &kp COLON     &kp SEMICOLON  &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp COMMA     &kp PERIOD    &kp BACKSLASH  &kp BACKSPACE
                                       &trans         &kp DELETE      &trans             &trans            &none              &trans
            >;
        };

        nav_rus {
            bindings = <
        &trans  &trans  &trans         &trans  &kp BACKSLASH    &trans  &kp HOME  &trans    &kp END     &kp LBKT
        &trans  &trans  &kp PAGE_UP    &trans  &trans           &trans  &kp LEFT  &kp UP    &kp RIGHT   &kp PERCENT
&trans  &trans  &trans  &kp PAGE_DOWN  &trans  &trans           &trans  &kp RBKT  &kp DOWN  &kp KP_DOT  &trans       &trans
                        &none          &trans  &trans           &trans  &trans    &trans
            >;
        };

        sym_func {
            bindings = <
        &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp LC(UP)    &kp C_AC_SEARCH   &kp LS(LG(NUMBER_4))    &kp LG(L)  &kp C_PREV         &kp C_PLAY_PAUSE   &kp C_NEXT         &kp LC(LG(Q))
        &none                 &none                 &none         &none             &none                   &none      &kp C_MUTE         &kp C_VOLUME_DOWN  &kp C_VOL_UP       &none
&trans  &kp LEFT_SHIFT        &kp LEFT_CONTROL      &kp LEFT_ALT  &kp LEFT_COMMAND  &none                   &none      &kp RIGHT_COMMAND  &kp RIGHT_ALT      &kp RIGHT_CONTROL  &kp RIGHT_SHIFT  &none
                                                    &trans        &trans            &trans                  &none      &trans             &trans
            >;
        };

        device {
            bindings = <
       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
       &none         &none         &none         &none         &none           &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&none  &none         &none         &none         &none         &bt BT_CLR      &kp F11  &kp F12  &none   &none   &none    &none
                                   &none         &none         &none           &none    &none    &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 3>;
            then-layer = <4>;
        };
    };
};
